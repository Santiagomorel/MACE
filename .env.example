# Environment variables template
# Copy to .env and fill with actual values

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/credential_rotation
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Active profile (dev, staging, prod)
SPRING_PROFILES_ACTIVE=dev

# Admin API key
ADMIN_API_KEY=

# GitGuardian webhook
GITGUARDIAN_WEBHOOK_SECRET=

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=*

# AWS configuration
AWS_REGION=us-east-1

# Vault encryption key (32 chars for AES-256)
VAULT_ENCRYPTION_KEY=

# Notifications
SLACK_WEBHOOK_URL=
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=587
EMAIL_FROM=security@mace.local
TICKET_WEBHOOK_URL=

# Admin API key enforcement
ADMIN_API_KEY_ENFORCE=true
